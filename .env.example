# Copy this file to .env and fill in the values from the course Moodle page.
# .env is git-ignored and must never be committed - it carries a shared credential.
#
# There is no OpenAI key. The university holds the credential and your requests go
# through the UNSW course proxy, which is what these three settings describe.

STUDENT_AI_PROXY_URL=
STUDENT_AI_ACCESS_CODE=
STUDENT_ID=

# Optional. The client defaults are correct for this course; set these only if the
# course announces a change.
#
# STUDENT_AI_MODEL=gpt-5.4-mini
# STUDENT_AI_REQUESTS_PER_MINUTE=60
# STUDENT_AI_TOKENS_PER_DAY=
# STUDENT_AI_TIMEOUT=
