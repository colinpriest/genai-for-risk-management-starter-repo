# CREDENTIALS. Never commit any of these. `.env` holds your UNSW proxy access code and
# your zID; a committed access code has to be revoked by IT, and git history keeps it
# even after you delete the file. The variants are listed because `.env` alone let
# `.env.local`, `.env.backup` and `env.txt` through.
.env
.env.*
!.env.example
*.env
env.txt
secrets.json
credentials.json
*.pem
*.key
!constraints.txt

__pycache__/
*.pyc
.pytest_cache/
desktop.ini

# Derived intermediates — rebuilt by `python src/data_panel.py`
data/processed/decisions.parquet
data/processed/macro_asof.parquet
data/processed/rates_daily.parquet
data/processed/panel.parquet
data/processed/tiers.json

# Shock context documents: each team downloads its own; not redistributable. The
# MANIFEST you write about them is required evidence and MUST be committed - an earlier
# rule ignored the whole folder, so a team could pass the submission check locally and
# push a repository with sources.json silently missing.
data/raw/context/*
!data/raw/context/README.md
!data/raw/context/sources.json.template
!data/raw/context/sources.json

# Everything below is REQUIRED and must be committed.
# The supplied frozen Cycle model card:
!data/processed/panel_frozen.parquet
!data/processed/tiers_frozen.json
!outputs/model_card/**
# Your own submitted evidence. The three raw-call directories are where every API
# response is cached, so a marker can reproduce your numbers without a key:
!data/processed/llm_raw/**
# Envelopes from superseded prompt versions: provenance only, not the run the
# report describes. Keep them locally, do not ship them.
data/processed/llm_raw/_superseded/**
!data/processed/construct_scores.parquet
!outputs/cycle.json
!outputs/words_audit.json
!outputs/words_validation.json
!outputs/replay.json
!data/processed/replay_raw/**
!outputs/shock.json
!outputs/tot_trees.json
!data/processed/shock_raw/**
!outputs/reaction_profiles.json
