.env
.venv/
__pycache__/
*.pyc
.ipynb_checkpoints/

# Stage outputs are regenerated; do not commit them
data/interim/*
data/processed/*
!data/**/.gitkeep

# EXCEPTION: raw LLM responses MUST be committed for reproducibility
!data/processed/llm_raw/
!data/processed/llm_raw/**

# EXCEPTION: the human agreement labels are EVIDENCE, not regenerable output. The blind
# labels and their commit timestamps are what prove the labelling was done before anyone saw
# the model's scores - section 8.2 Part B. Without this exception the rule above silently
# ignores them, `git add` reports nothing, and the evidence never reaches the repository.
!data/processed/agreement/
!data/processed/agreement/**

outputs/figures/*
!outputs/figures/.gitkeep

# The brief requires a FIXED copy of your market data so results reproduce. data/processed/ is
# ignored, so the snapshot lives here and IS tracked.
!data/snapshot/
!data/snapshot/**

# Windows Explorer / macOS / pytest droppings - never part of a submission
desktop.ini
.DS_Store
Thumbs.db
.pytest_cache/
